# ==============================================================================
# ProcureHub UAE Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Development: config.settings.development | Production: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# In production, generate a cryptographically strong 50+ character secret key
SECRET_KEY=change-me-to-a-secure-50-character-random-secret-key-for-production!

# Set to False in production
DEBUG=True

# Comma-separated list of hostnames/IPs this site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated list of trusted origins for CSRF (include scheme https://)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Leave blank for local SQLite (zero-setup demo)
# For PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# Require SSL for PostgreSQL connections (set to True on managed cloud hosts)
DB_SSL_REQUIRE=False

# ------------------------------------------------------------------------------
# 3. PRODUCTION HTTPS & SECURITY HEADERS (Active when DJANGO_SETTINGS_MODULE=config.settings.production)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 4. PLATFORM LOCALIZATION & MOCK SETTINGS
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=AED
ENABLE_MOCK_PAYMENTS=True
