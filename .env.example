# ProcureHub UAE Environment Configuration

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret Key (generate a strong one for production)
SECRET_KEY=django-insecure-procurehub-demo-secret-key-dubai-2026-b2b-platform

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CSRF Trusted Origins (comma-separated, include scheme e.g. https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database URL (optional, defaults to local SQLite if empty)
# PostgreSQL format: postgresql://user:password@localhost:5432/procurehub
DATABASE_URL=

# Default Currency
DEFAULT_CURRENCY=AED

# Demo / Mock Gateway Settings
ENABLE_MOCK_PAYMENTS=True
